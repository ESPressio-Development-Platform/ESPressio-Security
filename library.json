{
  "name": "ESPressio-Security",
  "version": "0.3.1",
  "description": "Transport-neutral authenticated encryption, authentication and replay protection for the ESPressio Development Platform",
  "keywords": "espressio,security,encryption,aead,aes,gcm,ccm,chacha20,poly1305,transport,authentication,replay,observable,event",
  "homepage": "https://espressio.org",
  "repository": {"type": "git", "url": "https://github.com/ESPressio-Development-Platform/ESPressio-Security.git"},
  "authors": {"name": "Simon J. Stuart", "maintainer": true, "url": "https://espressio.org"},
  "license": "Apache-2.0",
  "frameworks": "*",
  "platforms": "*",
  "build": {
    "flags": ["-std=gnu++17", "-frtti", "-DESPRESSIO_SECURITY"],
    "unflags": ["-fno-rtti"]
  },
  "dependencies": [
    {
      "name": "ESPressio-Observable",
      "version": ">=3.0.2 <4.0.0",
      "url": "https://github.com/ESPressio-Development-Platform/ESPressio-Observable.git"
    }
  ]
}
